SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.dev,.ngrok.io
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shop-owner EMAIL (Gmail App Password) — copy to backend/.env (not this file)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=yourshop@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=yourshop@gmail.com

# Shop-owner SMS (Fast2SMS) — copy API key into backend/.env
# FAST2SMS_API_KEY=your_fast2sms_api_key

# Link used in owner email CTA button
# FRONTEND_APP_URL=http://localhost:5173/notifications
