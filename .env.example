# Use relative /api so Vite proxies to Django (works with ngrok HTTPS).
# For direct backend calls without proxy: http://127.0.0.1:8001/api
VITE_API_URL=/api

# Support (Live chat → WhatsApp / email)
VITE_SUPPORT_WHATSAPP=919687401551
VITE_SUPPORT_EMAIL=support@dailyledger.app

# Optional: direct desktop installer URL (.exe / store). Leave empty to use PWA install.
# VITE_DESKTOP_APP_URL=https://example.com/daily-ledger-setup.exe
