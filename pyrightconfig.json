{
  "include": ["backend"],
  "exclude": [
    "**/venv",
    "**/__pycache__",
    "**/node_modules",
    "**/migrations/**"
  ],
  "venvPath": "backend",
  "venv": "venv",
  "extraPaths": ["backend"],
  "pythonVersion": "3.12",
  "typeCheckingMode": "off",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "executionEnvironments": [
    {
      "root": "backend",
      "python": "./backend/venv/Scripts/python.exe",
      "extraPaths": ["."],
      "pythonVersion": "3.12"
    }
  ]
}
